
[epel]
name=Extra Packages for Enterprise Linux 10 - $basearch
# It is much more secure to use the metalink, but if you wish to use a local mirror
# place its url here.
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-10&arch=$basearch&infra=$infra&content=$contentdir
enabled=1
gpgcheck=1
countme=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-10

[epel-debuginfo]
name=Extra Packages for Enterprise Linux 10 - $basearch - Debug
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-debug-10&arch=$basearch&infra=$infra&content=$contentdir
enabled=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-10
gpgcheck=1

[epel-source]
name=Extra Packages for Enterprise Linux 10 - $basearch - Source
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-source-10&arch=$basearch&infra=$infra&content=$contentdir
enabled=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-10
gpgcheck=1
